FROM golang:1.26

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
RUN go install github.com/go-delve/delve/cmd/dlv@v1.27.2

COPY . .
RUN CGO_ENABLED=0 go build -gcflags="all=-N -l" -o /manager ./cmd

USER 65532:65532
ENTRYPOINT ["/go/bin/dlv", "exec", "--headless", "--listen=:40000", "--accept-multiclient", "--continue", "/manager", "--"]